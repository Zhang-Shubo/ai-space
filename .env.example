# ai-space configuration. Copy to .env; Bun loads it automatically.

# Space API bind address. Keep 127.0.0.1 and put a tunnel + Access in front.
SPACE_HOST=127.0.0.1
SPACE_PORT=8700

# SQLite file for the scheduler (tasks + run history).
SPACE_DB=data/space.db

# Comma-separated app directories that contain a space.yaml; synced on boot.
SPACE_APPS=~/.awesome-agent/projects/finance-news-feed

# Bearer token required by mutating API routes. Empty = no check (127.0.0.1 only).
SPACE_API_TOKEN=

# How many task runs may execute at the same time.
SPACE_MAX_CONCURRENCY=2

# Any other variable here is visible to `${VAR}` placeholders in app manifests,
# e.g. the write token an app expects on its trigger endpoint.
# NEWS_FEED_WRITE_TOKEN=
