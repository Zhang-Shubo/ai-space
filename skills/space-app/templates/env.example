# Every variable the service reads. Real values live in .env (ignored by git) or,
# inside an ai-space workspace, in <workspace>/data/my-app/space.env which
# ai-space generates from space.yaml. Never put real values in this file.

# Set by ai-space from space.yaml (service.port). Bind 127.0.0.1 only.
PORT=8710

# Public URL of the app, used for the links the widget returns.
PUBLIC_BASE=https://my-app.example.com

# Provided by ai-space when space.yaml declares storage; do not set by hand.
# DATABASE_URL=sqlite:///path/to/main.db
# BLOB_URL=file:///path/to/blobs
